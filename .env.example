# ============================================
# 青萍小台 MVP - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=qingping

# ============================================
# 后端服务配置
# ============================================
# 后端监听地址
BACKEND_HOST=0.0.0.0
# 后端监听端口（Nginx 反向代理到此端口）
BACKEND_PORT=8081

# ============================================
# JWT 认证配置
# ============================================
# JWT 密钥（生产环境务必修改为随机字符串）
JWT_SECRET_KEY=your-secret-key-please-change-in-production-env
# JWT 加密算法
JWT_ALGORITHM=HS256
# Token 过期时间（分钟）
JWT_EXPIRE_MINUTES=1440

# ============================================
# 文件上传配置
# ============================================
# 上传文件存储目录
UPLOAD_DIR=./uploads
# 最大上传文件大小（字节），默认 50MB
MAX_UPLOAD_SIZE=52428800

# ============================================
# 大语言模型配置
# ============================================
# LLM API Key
LLM_API_KEY=your-llm-api-key-here
# LLM API 基础地址
LLM_BASE_URL=https://api.openai.com/v1
# 对话使用的模型名称
LLM_MODEL=gpt-4
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-ada-002
# 模型温度参数
LLM_TEMPERATURE=0.7
# 最大 token 数
LLM_MAX_TOKENS=4096

# ============================================
# 向量数据库配置
# ============================================
# 向量数据库类型（chroma/milvus/pgvector）
VECTOR_DB_TYPE=chroma
# 向量数据库持久化目录
VECTOR_DB_PATH=./vector_store

# ============================================
# 日志配置
# ============================================
# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
# 日志目录
LOG_DIR=./logs
