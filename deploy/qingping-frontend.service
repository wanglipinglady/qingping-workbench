# ============================================
# 青萍小台 MVP - 前端 Systemd 服务配置
# ============================================
# 说明: 通常前端使用 Nginx 提供静态文件服务即可
# 此服务文件用于开发环境或特殊场景下使用 Vite 预览模式
#
# 安装方式:
#   sudo cp qingping-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable qingping-frontend
#   sudo systemctl start qingping-frontend
#
# 管理命令:
#   sudo systemctl start/stop/restart/status qingping-frontend
#   sudo journalctl -u qingping-frontend -f
# ============================================

[Unit]
Description=Qingping MVP Frontend Service
After=network.target

[Service]
# 运行用户
User=www-data
Group=www-data

# 工作目录
WorkingDirectory=/opt/qingping-mvp/frontend

# 启动命令（使用 vite preview 提供静态文件服务）
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5173

# 环境变量
Environment=NODE_ENV=production
Environment=VITE_API_BASE_URL=http://localhost:8080/api

# 重启策略
Restart=on-failure
RestartSec=5s

# 资源限制
LimitNOFILE=65535

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qingping-frontend

[Install]
WantedBy=multi-user.target
