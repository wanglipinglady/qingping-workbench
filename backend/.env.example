# ============================================
# 青萍小台 MVP - 环境变量配置文件
# ============================================
# 使用方式：复制本文件为 .env，然后修改对应配置值
#   cp .env.example .env
# ============================================

# ========== 1. 基础配置 ==========
# 应用名称
APP_NAME=青萍小台
# 应用版本
APP_VERSION=0.1.0
# 服务监听地址（0.0.0.0 表示允许外部访问）
HOST=0.0.0.0
# 服务端口
# 注意：云服务器已占用端口 8501、8000、3306、443、22、80，请使用其他端口
PORT=8080
# 调试模式（生产环境请设为 false）
DEBUG=true

# ========== 2. MySQL 数据库配置 ==========
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 示例（生产部署）:
#   DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/qingping?charset=utf8mb4
#
# 本地开发默认使用 SQLite（无需安装 MySQL，开箱即用）:
DATABASE_URL=sqlite:///./data/qingping.db

# ========== 3. JWT 认证配置 ==========
# JWT 签名密钥（生产环境请修改为强随机字符串！）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-secret-key-change-in-production-please-change-this
# JWT 签名算法
JWT_ALGORITHM=HS256
# 访问令牌过期时间（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== 4. MiniMax 大模型 API 配置 ==========
# MiniMax API 密钥（在 https://www.minimaxi.com/ 控制台获取）
MINIMAX_API_KEY=your_minimax_api_key_here
# MiniMax API 基础地址（一般不需要改）
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# 对话模型名称
# MiniMax-M2.7 系列可选: MiniMax-M2.7-highspeed（快速）/ MiniMax-M2.7（高质量）
MINIMAX_CHAT_MODEL=MiniMax-M2.7-highspeed
# Embedding 向量模型名称
MINIMAX_EMBEDDING_MODEL=embo-01

# ========== 5. 向量数据库配置 ==========
# ChromaDB 持久化存储目录（本地文件存储，无需额外服务）
CHROMA_PERSIST_DIR=./data/chroma

# ========== 6. 文件上传配置 ==========
# 上传文件存储目录
UPLOAD_DIR=./uploads
# 单个文件最大大小（MB）
MAX_UPLOAD_SIZE=50

# ========== 7. CORS 跨域配置 ==========
# 允许跨域的来源，多个用逗号分隔
# 生产环境请设置为你的前端域名，如: https://yourdomain.com
CORS_ORIGINS=*

# ========== 8. 日志配置 ==========
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=./logs/app.log
