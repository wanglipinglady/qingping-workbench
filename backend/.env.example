# ============================================
# 青萍小台 - 环境配置模板
# 使用方法：复制此文件为 .env，然后修改其中的配置值
# 注意：.env 文件已在 .gitignore 中，不会被提交到 git
# ============================================

# ========== 基础配置 ==========
# 服务监听端口
PORT=8080
# 调试模式
DEBUG=false

# ========== 数据库配置 ==========
# 本地开发默认使用 SQLite（无需额外安装）
DATABASE_URL=sqlite:///./data/qingping.db

# 如果使用 MySQL，请注释上面一行，取消下面这行的注释并填写你的数据库信息
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:3306/数据库名?charset=utf8mb4
# 示例：
# DATABASE_URL=mysql+pymysql://remote_user:Pass@666@118.190.148.121:3306/dream?charset=utf8mb4

# ========== JWT 认证配置 ==========
# 生产环境请修改为强随机字符串
JWT_SECRET_KEY=your-secret-key-change-in-production-please-change-this

# ========== MiniMax API 配置 ==========
# MiniMax API 密钥（必填）
MINIMAX_API_KEY=sk-cp-crF61iHIxekGHshefJm0zWb6GFmL0x_tV47xBBYok369iI92IEWjdym7l6UXHXO-EmSyNqtJvd6v3qcjZdS-CoXH63u9Bt3Zl-EcA2mIF8ggnQdARmVp34c

# MiniMax API 基础地址
# 新版 API (sk-cp- 开头的 Key): https://api.minimaxi.com/v1
# 旧版 API (ab- 开头的 Key): https://api.minimax.chat/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 对话模型名称
# 可选: MiniMax-M2.7-highspeed, MiniMax-M3
MINIMAX_CHAT_MODEL=MiniMax-M2.7-highspeed

# Embedding 向量模型名称（用于知识库语义搜索）
MINIMAX_EMBEDDING_MODEL=embo-01

# ========== ChromaDB 向量数据库配置 ==========
# 持久化存储目录
CHROMA_PERSIST_DIR=./data/chroma

# ========== CORS 跨域配置 ==========
# 允许的来源，多个用逗号分隔，全部允许用 *
CORS_ORIGINS=*
