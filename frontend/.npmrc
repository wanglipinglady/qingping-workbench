# =====================================================
# 青萍小台 MVP - 前端 npm 配置
# 仅影响 frontend/ 目录下的 npm install / npm ci
# =====================================================

# 1. 严格校验 engines 字段：
#    如果当前 Node/npm 不满足 package.json 的 engines 区间，
#    npm 会直接报错退出（默认只是 warning，容易漏看）
engine-strict=true

# 2. 所有新增依赖默认写入精确版本（不带 ^/~）
#    配合 .nvmrc + packageManager 一起，确保 lockfile 不漂移
save-exact=true
save-prefix=

# 3. lockfile 版本（v3 与 npm 8.5.5 兼容）
lockfile-version=3

# 4. 不生成 package-lock.json 时跳过（避免空目录误生成）
package-lock=true

# 5. 优先使用 lockfile 的解析策略
fund=false
audit=false