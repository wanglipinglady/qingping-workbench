{
  "name": "qingping-mvp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "青萍小台 MVP 前端项目",
  "scripts": {
    "runtime:check": "node scripts/check-engines.mjs",
    "engines:check": "node scripts/check-engines.mjs",
    "predev": "npm run runtime:check",
    "dev": "vite",
    "prebuild": "npm run runtime:check",
    "build": "vite build",
    "prepreview": "npm run runtime:check",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "pretype-check": "npm run runtime:check",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "16.15.0",
    "npm": "8.5.5"
  },
  "packageManager": "npm@8.5.5",
  "overrides": {
    "node-releases": "$node-releases",
    "update-browserslist-db": "$update-browserslist-db"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.0",
    "zustand": "4.5.0",
    "axios": "1.6.7",
    "react-markdown": "9.0.1",
    "react-syntax-highlighter": "15.5.0",
    "remark-gfm": "4.0.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@types/react-syntax-highlighter": "15.5.11",
    "@types/node": "16.18.59",
    "@vitejs/plugin-react": "4.2.1",
    "typescript": "5.3.3",
    "vite": "4.5.14",
    "tailwindcss": "3.4.1",
    "postcss": "8.4.35",
    "autoprefixer": "10.4.17",
    "node-releases": "2.0.10",
    "semver": "7.6.3",
    "update-browserslist-db": "1.1.3"
  }
}
